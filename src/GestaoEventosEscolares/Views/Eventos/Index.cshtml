@model IReadOnlyList<EventoResumoViewModel>
@{
    ViewData["Title"] = "Eventos";
}

<section class="page-hero">
    <p class="eyebrow">Agenda</p>
    <h1 class="page-title">Eventos</h1>
    <p class="page-lead">
        @if (User.EhAdministrador())
        {
            <text>Administrador: todos os eventos da escola.</text>
        }
        else if (User.EhProfessor())
        {
            <text>Professor: eventos publicados e aqueles em que você foi autorizado.</text>
        }
        else
        {
            <text>Eventos publicados e em andamento.</text>
        }
    </p>
    @if (User.EhAdministrador() || User.EhProfessor())
    {
        <a class="btn btn-accent" asp-action="Create">Novo evento</a>
    }
</section>

@if (Model.Count == 0)
{
    <div class="empty-state">Nenhum evento visível no momento.</div>
}
else
{
    <div class="event-list">
        @foreach (var evento in Model)
        {
            <article class="event-card">
                <div class="event-card__thumb">
                    <img src="@ImagemEvento.Resolver(evento.CaminhoImagem)" alt="@evento.Titulo" />
                </div>
                <div class="event-card__meta">
                    <span class="@evento.Status.ParaClasseCss()">@evento.Status.ParaTexto()</span>
                    <span>@evento.TotalInscritos inscrito(s)</span>
                </div>
                <h2>@evento.Titulo</h2>
                <p>@evento.Local · @evento.DataInicio.ParaDataHora()</p>
                <div class="event-card__links">
                    <a class="text-link" asp-action="Details" asp-route-id="@evento.Id">Ver mais</a>
                    @if (evento.PodeEditar)
                    {
                        <a class="text-link" asp-action="Edit" asp-route-id="@evento.Id">Editar</a>
                    }
                    @if (evento.PodeGerenciarPermissoes)
                    {
                        <a class="text-link" asp-action="GerenciarPermissoes" asp-route-id="@evento.Id">Permissões</a>
                    }
                </div>
            </article>
        }
    </div>
}
