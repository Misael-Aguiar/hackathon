@model int
@{
    var acao = ViewContext.RouteData.Values["action"]?.ToString();
}

<nav class="event-tabs" aria-label="Gestão do evento">
    <a class="event-tabs__item @(acao == "Edit" ? "is-active" : null)"
       asp-action="Edit" asp-route-id="@Model">Dados do evento</a>
    @if (User.EhAdministrador())
    {
        <a class="event-tabs__item @(acao == "GerenciarPermissoes" ? "is-active" : null)"
           asp-action="GerenciarPermissoes" asp-route-id="@Model">Permissões</a>
    }
    <a class="event-tabs__item" asp-action="Details" asp-route-id="@Model">Ver página pública</a>
</nav>
