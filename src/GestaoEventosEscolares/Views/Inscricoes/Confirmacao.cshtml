@model ConfirmacaoInscricaoViewModel
@{
    ViewData["Title"] = Model.QrDisponivel ? "Inscrição confirmada" : "Inscrição";
}

<section class="qr-confirm">
    @if (Model.QrDisponivel)
    {
        <p class="eyebrow">Ingresso digital</p>
        <h1 class="page-title">Apresente este QR na entrada</h1>
        <p class="page-lead">@Model.NomeAluno · RM @Model.RM</p>

        <div class="qr-card">
            <p class="qr-card__kicker">Eventos Escolares</p>
            <div class="qr-card__frame">
                <img src="@Url.Action("QrCode", "Inscricoes", new { id = Model.InscricaoId })" width="280" height="280" alt="QR Code da inscrição" />
            </div>
            <h2>@Model.TituloEvento</h2>
            <p>@Model.Local · @Model.DataInicio.ParaDataHora()</p>
            @if (Model.PresencaConfirmada)
            {
                <span class="badge-status badge-status--publicado">Presença já validada — QR já utilizado</span>
            }
            else
            {
                <span class="badge-status badge-status--rascunho">Aguardando check-in</span>
            }
            <p class="qr-card__hint">Se não conseguir escanear, digite este código no check-in:</p>
            <p class="qr-card__code">Código de check-in: <span>@Model.CodigoCheckInFormatado</span></p>
        </div>
    }
    else
    {
        <p class="eyebrow">Inscrição</p>
        <h1 class="page-title">QR Code invalidado</h1>
        <p class="page-lead">Esta inscrição foi cancelada. O QR e o código de check-in anteriores não passam na entrada.</p>
    }

    <div class="event-form__actions">
        @if (Model.PodeBaixarCertificado)
        {
            <a class="btn btn-accent" asp-controller="Certificados" asp-action="Download" asp-route-id="@Model.InscricaoId">Baixar certificado</a>
        }
        @if (Model.PodeCancelar)
        {
            <form asp-action="Cancelar" asp-route-id="@Model.InscricaoId" method="post"
                  onsubmit="return confirm('Cancelar a inscrição em @Model.TituloEvento? A vaga será liberada e o QR e o código de check-in deixarão de valer.');">
                <button type="submit" class="btn btn-ghost">Cancelar inscrição</button>
            </form>
        }
        <a class="btn btn-ghost" asp-controller="Eventos" asp-action="Details" asp-route-id="@Model.EventoId">Voltar ao evento</a>
        <a class="btn btn-ghost" asp-action="Minhas">Minhas inscrições</a>
        <a class="btn btn-ghost" asp-controller="Perfil" asp-action="Index">Meu perfil</a>
    </div>
</section>
