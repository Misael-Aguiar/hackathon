@model IReadOnlyList<ConfirmacaoInscricaoViewModel>
@{
    ViewData["Title"] = "Minhas inscrições";
}

<section class="page-hero">
    <p class="eyebrow">Aluno</p>
    <h1 class="page-title">Minhas inscrições</h1>
    <p class="page-lead">Guarde o QR Code de cada evento para apresentar na entrada.</p>
</section>

@if (Model.Count == 0)
{
    <div class="empty-state">Você ainda não se inscreveu em nenhum evento.</div>
}
else
{
    <div class="event-list">
        @foreach (var inscricao in Model)
        {
            <article class="event-card">
                <h2>@inscricao.TituloEvento</h2>
                <p>@inscricao.Local · @inscricao.DataInicio.ParaDataHora()</p>
                @if (inscricao.CertificadoEmitido)
                {
                    <span class="badge-status badge-status--andamento">Certificado emitido</span>
                }
                else if (inscricao.PresencaConfirmada)
                {
                    <span class="badge-status badge-status--publicado">Presente</span>
                }
                else
                {
                    <span class="badge-status badge-status--rascunho">Inscrito</span>
                }
                <div class="event-card__links">
                    <a class="text-link" asp-action="Confirmacao" asp-route-id="@inscricao.InscricaoId">Ver QR Code</a>
                    <a class="text-link" asp-controller="Eventos" asp-action="Details" asp-route-id="@inscricao.EventoId">Ver evento</a>
                    @if (inscricao.PodeBaixarCertificado)
                    {
                        <a class="text-link" asp-controller="Certificados" asp-action="Download" asp-route-id="@inscricao.InscricaoId">Baixar certificado</a>
                    }
                    @if (inscricao.PodeCancelar)
                    {
                        <form asp-action="Cancelar" asp-route-id="@inscricao.InscricaoId" method="post" class="d-inline"
                              onsubmit="return confirm('Cancelar a inscrição em @inscricao.TituloEvento?');">
                            <button type="submit" class="text-link btn-as-link">Cancelar inscrição</button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}
