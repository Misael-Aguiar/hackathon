<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Início") · Eventos Escolares</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header class="app-header">
        <nav class="navbar navbar-expand-lg app-nav">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                    <span class="brand__mark" aria-hidden="true"></span>
                    <span class="brand__text">Eventos Escolares</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Eventos" asp-action="Index">Eventos</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Painel" asp-action="Index">Painel</a>
                            </li>
                        }
                        @if (User.EhAdministrador() || User.EhProfessor())
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Eventos" asp-action="Create">Novo evento</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main class="app-main">
        <div class="container py-4">
            @if (TempData["MensagemSucesso"] is string mensagem)
            {
                <div class="flash-ok" role="status">@mensagem</div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container">
            <span>Gestão de Eventos Escolares</span>
            <span class="app-footer__sep">·</span>
            <span>Presença, inscrição e certificados</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
