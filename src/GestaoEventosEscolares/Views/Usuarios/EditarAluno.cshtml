@model EditarAlunoViewModel
@{
    ViewData["Title"] = "Editar aluno";
}

<partial name="_AbasUsuarios" />

<section class="page-hero">
    <p class="eyebrow">Somente administrador</p>
    <h1 class="page-title">Editar aluno</h1>
    <p class="page-lead">Altere nome, RM e sala. O histórico de presença e certificado permanece ligado a este cadastro.</p>
</section>

<section class="table-panel">
    <form asp-action="EditarAluno" asp-route-id="@Model.Id" method="post" class="user-form">
        <div asp-validation-summary="ModelOnly" class="form-alert"></div>
        <input type="hidden" asp-for="Id" />
        <div class="field-row field-row--3">
            <div class="field">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="form-control form-control-dark" autocomplete="name" />
                <span asp-validation-for="Nome" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="RM"></label>
                <input asp-for="RM" class="form-control form-control-dark" autocomplete="off" />
                <span asp-validation-for="RM" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Sala"></label>
                <select asp-for="Sala" class="form-control form-control-dark">
                    <option value="">Selecione</option>
                    @foreach (SalaTurma sala in Enum.GetValues<SalaTurma>())
                    {
                        <option value="@sala">@sala.ParaTexto()</option>
                    }
                </select>
                <span asp-validation-for="Sala" class="field-error"></span>
            </div>
        </div>
        <div class="event-form__actions">
            <button type="submit" class="btn btn-accent">Salvar alterações</button>
            <a class="btn btn-ghost" asp-action="Alunos">Cancelar</a>
        </div>
    </form>
    <form asp-action="ExcluirAluno" asp-route-id="@Model.Id" method="post" class="mt-3"
          onsubmit="return confirm('Excluir @Model.Nome? O login será bloqueado e as inscrições sem presença serão canceladas.');">
        <button type="submit" class="btn btn-ghost">Excluir aluno</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
